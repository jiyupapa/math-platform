# Supabase 백엔드 (선택) — 진도 크로스기기 저장.
# 미설정 시 앱은 localStorage 만 사용한다 (= 현재 동작, 백엔드 OFF). VITE_OLLAMA_URL 과 같은 게이팅 방식.
#
# 값 위치: Supabase 대시보드 → Project Settings → API
# 사용처: 각 앱 apps/*/web/.env (Vite 가 빌드 시 주입). anon key 는 공개 안전 — 보안은 RLS·도메인 트리거가 담당.
# ⚠️ service_role key 는 절대 여기·git 에 넣지 말 것.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 협업 주석 P3 — 관리자(강사) 이메일 목록 (콤마 구분, 소문자).
# 이 목록은 **UI 표시용**(강사 답변 폼·포털 질문 큐 메뉴를 그릴지)이다.
# 진짜 경계는 DB 의 public.admins 테이블 — **두 목록을 같게 유지할 것.**
# env 만 넣고 DB 를 안 고치면 폼은 보여도 저장이 거부된다(안전한 방향으로 실패).
#   insert into public.admins(email) values ('hong@solideos.com') on conflict do nothing;
VITE_ADMIN_EMAILS=

# ── E2E 회귀 스위트 (npm run e2e) — 실행법·주의는 e2e/README.md ──
# 테스트 계정은 포털에서 미리 가입해 둘 것(@solideos.com 도메인 트리거 통과 필요).
E2E_PASSWORD=
# E2E_USER_A=anna@solideos.com
# E2E_USER_B=annb@solideos.com
# E2E_BASE=http://localhost:4291          # 조립본 주소(npm run deploy:serve)
# E2E_BROWSER=                            # Edge/Chrome 경로 — 미지정 시 자동 탐색
# ⚠️ 관리자 자격증명은 평소 비워 둔다 — 관리자는 실제 강사 계정 한 명으로 한정하고
#    테스트 계정에 권한을 주지 않는다. 없으면 P3 는 "차단 경로"만 검증하고 건너뛴다.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
