# Supabase 백엔드 (선택) — 진도 크로스기기 저장.
# 미설정 시 앱은 localStorage 만 사용한다 (= 현재 동작, 백엔드 OFF). VITE_OLLAMA_URL 과 같은 게이팅 방식.
#
# 값 위치: Supabase 대시보드 → Project Settings → API
# 사용처: 각 앱 apps/*/web/.env (Vite 가 빌드 시 주입). anon key 는 공개 안전 — 보안은 RLS·도메인 트리거가 담당.
# ⚠️ service_role key 는 절대 여기·git 에 넣지 말 것.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
