apps/*/web/public/concept-graph.json

# 환경변수 (Supabase URL/anon key 등 로컬 설정) — .env.example 은 커밋, 실제 .env 는 제외
.env
.env.local
.env.*.local

# 임시 검증 스크립트 (scratch-*.mjs 등) — 커밋 제외
scratch-*

